# Anthropic — the agent brain
ANTHROPIC_API_KEY=

# RunPod — GPU compute
RUNPOD_API_KEY=
RUNPOD_SSH_PRIVATE_KEY_PATH=~/.ssh/runpod_ed25519
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_POD_DATACENTER=US-KS-2

# Literature
# Semantic Scholar works without a key but rate-limits aggressively; key raises the limit.
SEMANTIC_SCHOLAR_API_KEY=
# Used for arXiv polite User-Agent header.
CONTACT_EMAIL=you@example.com

# HuggingFace — for downloading benchmark datasets
HF_TOKEN=

# Local paths
WORKSPACE_ROOT=./workspaces
DB_PATH=./workspaces/state.db

# Logging
LOG_LEVEL=INFO

# API server
API_HOST=127.0.0.1
API_PORT=8000
